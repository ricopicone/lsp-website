# Environment variables for the LSP website.
#
# Local development needs no .env file at all: it defaults to SQLite,
# console email, and a development secret key. Copy this file to .env only
# to override something locally.

# --- Required in production --------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.lacanschool.org
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Email: Amazon SES (production) ------------------------------------
DJANGO_DEFAULT_FROM_EMAIL=no-reply@lacanschool.org
DJANGO_SUPPORT_EMAIL=website@lacanschool.org
DJANGO_EMAIL_HOST=email-smtp.us-west-2.amazonaws.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

# --- Stripe (test mode for dev) ----------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL used to build Stripe success/cancel return URLs.
SITE_BASE_URL=https://app.lacanschool.org

# --- S3 media (production) ---------------------------------------------
# When set, user uploads (Speaker.headshot, Profile.headshot, ...) are
# stored in the named S3 bucket and served from there. Leave blank for
# local dev (uploads land at BASE_DIR/media). On EC2, credentials come
# from the instance role — no AWS_ACCESS_KEY_ID needed here.
AWS_STORAGE_BUCKET_NAME=lsp-website-media-uswest2
AWS_S3_REGION_NAME=us-west-2

# --- Optional ----------------------------------------------------------
# DJANGO_DEBUG=false
# DJANGO_TIME_ZONE=America/Los_Angeles
