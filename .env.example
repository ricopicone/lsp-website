# Environment variables for the LSP website.
#
# Local development needs no .env file at all: it defaults to SQLite,
# console email, and a development secret key. Copy this file to .env only
# to override something locally.

# --- Required in production --------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.lacanschool.org
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Email: Amazon SES (production) ------------------------------------
DJANGO_DEFAULT_FROM_EMAIL=no-reply@lacanschool.org
DJANGO_SUPPORT_EMAIL=website@lacanschool.org
DJANGO_EMAIL_HOST=email-smtp.us-west-2.amazonaws.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

# Self-service login-email change. Until launch, leave PUBLIC false and list
# only test addresses (comma-separated) that may use it — handy while SES is
# in sandbox (it only delivers to verified identities). Set PUBLIC=true to
# open it to all members at launch.
DJANGO_EMAIL_CHANGE_PUBLIC=false
DJANGO_EMAIL_CHANGE_ALLOWLIST=dr@ricopic.one

# Admin two-factor auth. Enrollment (/accounts/2fa/setup/) is always available;
# this flag controls *enforcement* — forcing admins through TOTP setup + a
# per-session challenge. Ships false so testers aren't blocked; set true at
# launch to require 2FA for anyone with an admin role.
DJANGO_TWO_FACTOR_ENFORCED=false

# --- Stripe (test mode for dev) ----------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL used to build Stripe success/cancel return URLs.
SITE_BASE_URL=https://app.lacanschool.org

# --- Daily.co video rooms ----------------------------------------------
# In-site browser meeting rooms (one per Workgroup). Off until a key is set.
DJANGO_DAILY_ENABLED=false
DAILY_API_KEY=
DAILY_DOMAIN=                       # e.g. lsp.daily.co
# DAILY_API_URL=https://api.daily.co/v1
# DJANGO_DAILY_TOKEN_TTL_MINUTES=180
# DJANGO_DAILY_MAX_PARTICIPANTS=0   # 0 = unset
# Recording (base64 HMAC secret from the Daily webhook; own-S3 is optional)
DAILY_WEBHOOK_SECRET=
# DJANGO_RECORDING_OWN_S3=false
# AWS_RECORDINGS_BUCKET_NAME=
# DJANGO_RECORDING_RETENTION_DAYS=365

# --- S3 media (production) ---------------------------------------------
# When set, user uploads (Speaker.headshot, Profile.headshot, ...) are
# stored in the named S3 bucket and served from there. Leave blank for
# local dev (uploads land at BASE_DIR/media). On EC2, credentials come
# from the instance role — no AWS_ACCESS_KEY_ID needed here.
AWS_STORAGE_BUCKET_NAME=lsp-website-media-uswest2
AWS_S3_REGION_NAME=us-west-2

# --- Parlêtre (members-only discussion board) --------------------------
# Reply-by-email: when enabled, SES inbound → SNS → the /parletre webhook
# turns email replies into posts. Currently validated on a test domain
# pending the lacanschool.org DNS migration; leave disabled in dev.
# PARLETRE_REPLY_ENABLED=false
# PARLETRE_REPLY_DOMAIN=parletre.lacanschool.org
# PARLETRE_SNS_TOPIC_ARN=arn:aws:sns:us-west-2:...:parletre-inbound
# PARLETRE_REPLY_SECRET=                 # defaults to DJANGO_SECRET_KEY
# Realtime chat channel layer. In-memory (default) is correct for the
# single-daphne prod deploy; only enable Redis for a multi-process setup.
# PARLETRE_USE_REDIS=false
# REDIS_URL=redis://localhost:6379/0

# --- Self-service login-email change -----------------------------------
# Gated to an allowlist until launch; flip PUBLIC=true to open to all.
# DJANGO_EMAIL_CHANGE_ALLOWLIST=dr@ricopic.one
# DJANGO_EMAIL_CHANGE_PUBLIC=false

# --- Optional ----------------------------------------------------------
# DJANGO_DEBUG=false
# DJANGO_TIME_ZONE=America/Los_Angeles
