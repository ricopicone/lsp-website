# Environment variables for the LSP website.
#
# Local development needs no .env file at all: it defaults to SQLite,
# console email, and a development secret key. Copy this file to .env only
# to override something locally.

# --- Required in production --------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=register.lacanschool.org
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Email: Amazon SES (production) ------------------------------------
DJANGO_DEFAULT_FROM_EMAIL=no-reply@lacanschool.org
DJANGO_EMAIL_HOST=email-smtp.us-west-2.amazonaws.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=

# --- Optional ----------------------------------------------------------
# DJANGO_DEBUG=false
# DJANGO_TIME_ZONE=America/Los_Angeles
