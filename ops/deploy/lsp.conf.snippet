# Excerpt of /etc/nginx/conf.d/lsp.conf showing the blue-green change. The only
# edit to the Certbot-managed server block: both proxy_pass targets point at the
# `lsp_app` upstream (defined in lsp-active.conf) instead of a hardcoded
# 127.0.0.1:8000. Everything else (SSL, the WS upgrade headers, timeouts) is
# unchanged.

    location /ws/ {
        proxy_pass http://lsp_app;          # was http://127.0.0.1:8000
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://lsp_app;          # was http://127.0.0.1:8000
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
